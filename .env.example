# Copy this file to `.env` and fill in the real value:
#   cp .env.example .env
#
# `.env` is listed in .gitignore and must NEVER be committed.

# Cloudflare Tunnel connector token.
# Get it from: Zero Trust dashboard > Networks > Tunnels > <your tunnel>
#   > Configure > "Install and run a connector" (copy the --token value only).
# This is NOT the same thing as a Cloudflare API Token — don't mix them up.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
